def escala(s): #ya probada
    n = len(s)
    res = np.zeros((n,n))
    
    for i in range(n):
        res[i,i] = s[i]
    
    return res
            
assert(np.allclose(escala([2,3]),np.array([[2,0],[0,3]])))
assert(np.allclose(escala([1,1,1]),np.eye(3)))
assert(np.allclose(escala([0.5,0.25]),np.array([[0.5,0],[0,0.25]])))

def rota_y_escala(theta,s): #ya probada
    
    return mult_matricial(escala(s),rota(theta))

def afin(theta,s,b): #ya probado
    res = np.eye(3)

    rotado = rota_y_escala(theta,s)

    m,n = rotado.shape
    for i in range(m):
        for j in range(n):
            res[i,j] = rotado[i,j]

    res[0,2] = b[0]
    res[1,2] = b[1]

    return res

def trans_afin(v,theta,s,b):
    b_arr = np.array(b)
    
    m = afin(theta,s,b_arr)
    v_arr = np.array([[v[0]], 
                      [v[1]], 
                      [1.0]])
    
    w_homogéneo = mult_matricial(m,v_arr)

    return w_homogéneo[:2,0]
    

assert(np.allclose(trans_afin(np.array([1,0]),np.pi/2,[1,1],[0,0]),np.array([0,1])))
assert(np.allclose(trans_afin(np.array([1,1]),0,[2,3],[0,0]),np.array([2,3])))
assert(np.allclose(trans_afin(np.array([1,0]),np.pi/2,[3,2],[4,5]),np.array([4,7])))
